<h1>Editar categoria</h1>

<form action="/categorias/<%= categoria.id %>" method="POST">

    <label>Nome:</label>
    <input
        type="text"
        name="nome"
        required
        value="<%= categoria.nome %>"
    >

    <br>

    <button type="submit">
        Atualizar
    </button>

</form>
